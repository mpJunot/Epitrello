# Database
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="epitrello"
POSTGRES_PORT=5432

# Database URL
# For Docker: use 'postgres' as hostname
# For local development: use 'localhost' as hostname
# format: postgresql:// <username> : <password> @ <host> : <port> / <dbname> ?schema=public
# For Docker (backend + db in compose) set POSTGRES_HOST to 'postgres'
# For local development (backend local + db Docker) set POSTGRES_HOST to 'localhost'
POSTGRES_HOST=postgres

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# JWT
# Generate a secure random secret for production
# You can use: openssl rand -hex 64
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Application
PORT=4000
NODE_ENV="development"
# if using Docker, set to: http://postgres:3000
# if local development, set to: http://localhost:3000
FRONTEND_URL="http://localhost:3000"

# Frontend
FRONTEND_PORT=3000

# if using Docker, set to: http://postgres:4000/graphql
# if local development, set to: http://localhost:4000/graphql
NEXT_PUBLIC_API_URL="http://localhost:4000/graphql"

# Resend API
# Get your API key from https://resend.com
# If not set, emails will be logged to console (development mode)
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="onboarding@resend.dev"

# Authentication Providers
# Just uncomment the ones you want to use and set your credentials
# Uncommented ones must have their credentials set

# Google OAuth2
# Go to https://console.developers.google.com/ to create your OAuth2 credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# Apple OAuth2
# Go to https://developer.apple.com/account/resources/authkeys/list to create your OAuth2 credentials
# APPLE_CLIENT_ID="com.yourcompany.epitrello.service"
# APPLE_TEAM_ID="XXXXXXXXXX"  # Your Team ID (10 characters)
# APPLE_KEY_ID="XXXXXXXXXX"   # The Key ID of your .p8 key
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APPLE_CALLBACK_URL="http://localhost:4000/auth/apple/callback"
# Note: Don't forget to download the .p8 key file and set APPLE_PRIVATE_KEY with the key content

# Microsoft OAuth2
# Go to https://portal.azure.com/ to create your OAuth2 credentials
MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"
MICROSOFT_CALLBACK_URL="http://localhost:4000/auth/microsoft/callback"

# Slack OAuth2
# Go to https://api.slack.com/apps to create your OAuth2 credentials
# SLACK_CLIENT_ID="xxxxxxxxxxxxx.xxxxxxxxxxxxx"
# SLACK_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# SLACK_CALLBACK_URL="http://localhost:4000/auth/slack/callback"
